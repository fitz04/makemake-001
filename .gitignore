# Godot 4 .gitignore

# Godot-specific ignores
.godot/
*.translation

# Godot exported builds
export/
export_presets.cfg

# Imported resources (regenerated by Godot)
project/.godot/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
build/
*.o
*.exe
*.dll
*.so
*.dylib

# Godot custom build (large binaries)
godot-builds/
godot-source/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Temporary files
*.tmp
*.bak
*.log

# Secrets / credentials (never commit)
.env
*.key
*.pem
credentials.*

# Voxel terrain cache
project/debug_data/*.sqlite
