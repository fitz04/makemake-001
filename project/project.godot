; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be manually edited if needed.
; See https://docs.godotengine.org/en/stable/tutorials/io/data_paths.html

config_version=5

[application]

config/name="Project Nomad"
config/description="First-person hard-SF survival crafting simulation on a Kuiper Belt dwarf planet"
config/tags=PackedStringArray("3d", "survival", "crafting", "voxel")
run/main_scene=""
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoloads/game_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

